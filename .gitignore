# JetBrains project state. workspace.xml and the .iml carry absolute local
# paths and per-user state.
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
# Regenerated by CLion and named after whatever the directory is called;
# the directory has already been renamed once.
.idea/misc.xml
.idea/modules.xml
.idea/*.iml
.idea/.name
cmake-build-*/
# Generated by `make ide` (pio project init --ide clion) for indexing only.
# Derived files: regenerate, never edit, never commit.
CMakeLists.txt
CMakeListsPrivate.txt

# PlatformIO, if firmware ends up being built here.
.pio/

# Third-party libraries pulled by scripts/fetch-libraries.sh. Other people's
# code; this repo ships the script and the pinned refs instead.
#
# NOT lib/ -- that is PlatformIO's home for OUR shared libraries and is
# committed. Fetched code goes to vendor/.
vendor/

# Source archives: whole repositories and tutorial zips, other people's code.
# scripts/fetch-libraries.sh pulls what is needed from the original sources,
# and docs/assets.md records every URL, commit and hash. Never commit these.
etc/firmware/

# Mirrored vendor web pages. These are CC BY-SA 4.0 and could be committed,
# but they carry SparkFun's Google Tag Manager and social-network beacons,
# share-alike sits awkwardly in an MIT repository, and docs/assets.md plus
# docs/SHA256SUMS already let anyone refetch and verify them.
docs/sparkfun-hookup-guide.html
docs/sparkfun-tutorial-1ch-gateway-ttn.html

# NOTE: docs/datasheets/ is deliberately NOT ignored. The component datasheets
# ARE committed -- see docs/datasheets/README.md for the reasoning and the
# takedown offer. This is a considered exception, not an oversight; do not
# "fix" it by adding the directory back.

# All local secrets in one place, ignored as a directory rather than by
# file pattern so whatever lands there next is covered too.
etc/secrets/
secrets/

# Anything deliberately kept local.
*.local.md
*.local.json
docs/*.local.*
*.local.sh
scripts/local-*.sh

# Claude Code local overrides and scratch.
.claude/settings.local.json
.claude_artifacts/

# Bytecode from scripts/lib/mask.py, which the scripts import.
__pycache__/
*.pyc
